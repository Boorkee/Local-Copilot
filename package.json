{
  "name": "local-copilot",
  "displayName": "Local Copilot",
  "description": "A VS Code chat sidebar powered by local Ollama models.",
  "version": "0.2.0",
  "publisher": "local-copilot",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:localCopilot.chat"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "localCopilot",
          "title": "Local Copilot",
          "icon": "resources/copilot.svg"
        }
      ]
    },
    "views": {
      "localCopilot": [
        {
          "id": "localCopilot.chat",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "localCopilot.newChat",
        "title": "New Chat",
        "category": "Local Copilot",
        "icon": "$(add)"
      },
      {
        "command": "localCopilot.showChats",
        "title": "Show Chats",
        "category": "Local Copilot",
        "icon": "$(history)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "localCopilot.newChat",
          "when": "view == localCopilot.chat",
          "group": "navigation@1"
        },
        {
          "command": "localCopilot.showChats",
          "when": "view == localCopilot.chat",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Local Copilot",
      "properties": {
        "localCopilot.ollamaBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Base URL for the local Ollama HTTP API."
        },
        "localCopilot.defaultModel": {
          "type": "string",
          "default": "auto:balanced",
          "description": "Chat model on startup. Use auto:balanced (recommended), auto:fast, auto:quality, or an installed Ollama model name."
        },
        "localCopilot.codeModel": {
          "type": "string",
          "default": "auto:balanced",
          "description": "Agent and Plan model on startup. Auto routing selects only verified tool-capable installed Ollama models. Choose a model name to override."
        },
        "localCopilot.requestTimeoutMs": {
          "type": "number",
          "default": 300000,
          "minimum": 1000,
          "description": "Maximum time to wait for an Ollama request."
        },
        "localCopilot.modelResidency": {
          "type": "string",
          "enum": [
            "automatic",
            "conserve",
            "keep"
          ],
          "default": "automatic",
          "description": "Automatic lets Ollama manage models (recommended). Conserve unloads only Local Copilot's previous model when switching; this can affect other clients sharing it. Keep asks Ollama to retain the current model in memory."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run build:webview",
    "test": "npm run compile && tsc -p tsconfig.test.json && node scripts/run-tests.js",
    "package": "npx --yes @vscode/vsce@3.9.2 package --allow-missing-repository",
    "handoff": "node out/cli/handoff.js",
    "watch": "tsc -watch -p ./",
    "build:webview": "tsc -p webview/tsconfig.json && node scripts/build-webview.js",
    "watch:webview": "node scripts/build-webview.js --watch",
    "test:webview": "npm run compile && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/diff": "^7.0.2",
    "@types/node": "^20.12.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "border-beam": "^1.4.1",
    "diff": "^9.0.0",
    "liquid-gooey": "^0.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "thinking-orbs": "^0.3.2",
    "voice-glow": "^0.3.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Chat remains available; agent tools and commands require a trusted workspace."
    }
  }
}
