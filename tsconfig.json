{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "types": [
      "node",
      "vscode"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "outDir": "out",
    "rootDir": "src",
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "out",
    "out-test",
    "test"
  ]
}
